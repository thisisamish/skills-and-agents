{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/thisisamish/skills-agents-and-such/main/.github/skills/save-experience-in-star-format/changelog_schema.json",
  "title": "Changelog",
  "description": "Changelog of EXPERIENCE_DB.md",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "changelogId": {
        "description": "The unique identifier for a changelog entry",
        "type": "string"
      },
      "changedItemsIds": {
        "description": "IDs of the items changed in EXPERIENCE_DB.md",
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "description": {
        "description": "1-2 lines describing what changed in EXPERIENCE_DB.md",
        "type": "string"
      }
    },
    "required": [ "changelogId", "changedItemsIds", "description" ],
    "additionalProperties": false
  }
}